{
  "name": "aplexanalysis-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:api && npm run test:performance",
    "test:unit": "node --no-warnings --experimental-strip-types --test tests/financial-regression.test.mjs tests/company-peer-selection.test.mjs tests/financial-normalization.test.mjs tests/cache-refactor.test.ts tests/provider-architecture.test.ts tests/ai-research.test.mjs",
    "test:integration": "node --no-warnings --experimental-strip-types --test tests/financial-ui-basics.test.mjs tests/ui-api-contracts.test.mjs tests/news-risk-providers.test.mjs",
    "test:api": "node --no-warnings --experimental-strip-types --test tests/market-api-integration.test.mjs",
    "test:performance": "node --no-warnings --experimental-strip-types --test tests/cache-efficiency.test.ts tests/scaling-protection.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@carbon/icons-react": "11.85.0",
    "@carbon/react": "1.113.0",
    "border-beam": "1.3.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "thinking-orbs": "0.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "sass": "^1.102.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
