# SEC asks automated clients to identify themselves with a real contact address.
SEC_USER_AGENT=AplexAnalysis/0.1 YOUR_CONTACT_EMAIL

# Optional canonical origin used for social metadata during non-production builds.
NEXT_PUBLIC_SITE_URL=https://aplexanalysis.aplex-1.chatgpt.site

# AI Research is off until explicitly configured. Never use NEXT_PUBLIC_ for keys.
AI_RESEARCH_ENABLED=false
AI_RESEARCH_PROVIDER=openrouter
AI_RESEARCH_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_MODEL=
GROQ_MODEL=

# 32 random bytes encoded as base64. Used only to encrypt account-owned provider keys.
ACCOUNT_SECRETS_KEY=
